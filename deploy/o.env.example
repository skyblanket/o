# O daemon configuration (copy to ~/.config/o/o.env and edit).
# Every variable is documented in the README's Environment table.

# Where the control plane lives and which port the API listens on (localhost only).
O_DB=%h/.o/o.db
O_PORT=4100
O_NO_OPEN=1

# Lock the API: company / agent / approval writes need this bearer token.
O_API_TOKEN=change-me

# Confine agent and reviewer runs (Linux, needs bubblewrap).
O_SANDBOX=bwrap

# Gates.
O_REVIEW=1
O_MERGE_GATE=1
O_MERGE_MODEL=claude-opus-5-5
# O_PR_AUTOMERGE=0        # PR-only: green PRs wait for a human

# GitHub intake and PR mode.
O_GH_LABEL=o
O_GH_POLL_S=60
O_CI_POLL_S=60
O_CI_TIMEOUT_S=5400

# Agent run limits.
O_MAX_TURNS=120
O_STALL_TIMEOUT_S=1800
O_VERIFY_TIMEOUT_S=900

# Spend: a hard daily ceiling across all companies (cents).
O_GLOBAL_DAILY_CENTS=2500

# Daily reflection pass.
O_REFLECT=1
